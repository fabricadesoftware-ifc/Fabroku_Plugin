#!/usr/bin/env bash
[[ " help fabroku:help " == *" $1 "* ]] || exit "${DOKKU_NOT_IMPLEMENTED_EXIT:-10}"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

fn-fabroku-help-content() {
  cat <<help_content
    fabroku:version, Versão do plugin (JSON)
    fabroku:deploy <app> <git-url> <branch> <deploy-id>, Inicia git:sync --build fora da sessão SSH
    fabroku:deploy-log <deploy-id> <offset> [max-bytes], Lê o log do deploy a partir de um offset
    fabroku:deploy-status <deploy-id>, Estado do deploy (running, succeeded, failed, cancelled, lost)
    fabroku:deploy-cancel <deploy-id> [segundos], Cancela o deploy e limpa containers parados
    fabroku:gc [dias], Apaga deploys finalizados há mais de N dias (padrão 7)
help_content
}

case "$1" in
  help)
    fn-fabroku-help-content
    ;;
  fabroku:help)
    echo "Usage: dokku fabroku[:COMMAND]"
    echo ""
    echo "Deploy desacoplado da conexão SSH para o Fabroku PaaS."
    echo ""
    echo "Additional commands:"
    fn-fabroku-help-content | sort | column -c2 -t -s,
    ;;
esac
