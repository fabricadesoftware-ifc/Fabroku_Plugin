#!/usr/bin/env bash
# Trigger do Dokku: roda como root no plugin:install e no plugin:update.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/internal-functions"

fn-fabroku-ensure-dirs
chown -R "${DOKKU_SYSTEM_USER:-dokku}:${DOKKU_SYSTEM_GROUP:-dokku}" "$FABROKU_DATA_ROOT"
chmod 700 "$FABROKU_DATA_ROOT" "$FABROKU_DEPLOYS_DIR" "$FABROKU_LOCKS_DIR"

# Instala o 00-fabroku-guard como plugin separado: o nome com "00-" faz o plugn rodar o
# core-post-extract dele antes dos plugins do Dokku que leem/executam arquivos do repositório.
PLUGINS_DIR="${PLUGIN_PATH:-/var/lib/dokku/plugins}"
GUARD_NAME="00-fabroku-guard"
if [[ -d "$PLUGINS_DIR/available" && -d "$PLUGINS_DIR/enabled" ]]; then
  rm -rf "${PLUGINS_DIR:?}/available/$GUARD_NAME"
  cp -R "$FABROKU_PLUGIN_ROOT/guard" "$PLUGINS_DIR/available/$GUARD_NAME"
  chmod 755 "$PLUGINS_DIR/available/$GUARD_NAME/core-post-extract"
  ln -sfn "$PLUGINS_DIR/available/$GUARD_NAME" "$PLUGINS_DIR/enabled/$GUARD_NAME"
else
  echo "fabroku: $PLUGINS_DIR/{available,enabled} não existe; $GUARD_NAME NÃO foi instalado" >&2
  exit 1
fi
