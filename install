#!/usr/bin/env bash
# Trigger do Dokku: roda como root no plugin:install e no plugin:update.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/internal-functions"

fn-fabroku-ensure-dirs
chown -R "${DOKKU_SYSTEM_USER:-dokku}:${DOKKU_SYSTEM_GROUP:-dokku}" "$FABROKU_DATA_ROOT"
chmod 700 "$FABROKU_DATA_ROOT" "$FABROKU_DEPLOYS_DIR" "$FABROKU_LOCKS_DIR"

# Instala o 00-fabroku-guard (plugin separado; o nome 00- faz rodar antes dos
# plugins do Dokku). Em plugin:update o trigger install NAO roda, entao rode
# manualmente depois:  sudo bash guard/enable.sh
bash "$FABROKU_PLUGIN_ROOT/guard/enable.sh" || echo "fabroku: falha ao instalar 00-fabroku-guard" >&2
